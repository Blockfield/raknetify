Subject: [PATCH] Build velocity module against pinned fill-API jar

The ivy dependency velocity:3.4.0-SNAPSHOT:540 resolved through
api.papermc.io v2, which Paper has sunset (410 Gone), so the velocity
module no longer configures. The exact build 540 is still served by the
fill API; fetch it from its content-addressed object URL with a pinned
SHA-256 instead. It stays a compile-only-style input: shadowJar only
bundles the shadowInclude configuration, so the server jar never lands
in the published plugin.

Pinned input: velocity-3.4.0-SNAPSHOT-540.jar
URL: https://fill-data.papermc.io/v1/objects/af292ea5c9c330fc3b367e48c7d1d448b1b3216f597798bfbef662d002b1343b/velocity-3.4.0-SNAPSHOT-540.jar
SHA-256: af292ea5c9c330fc3b367e48c7d1d448b1b3216f597798bfbef662d002b1343b
---
diff --git a/velocity/build.gradle b/velocity/build.gradle
index d705ccb..c24227b 100644
--- a/velocity/build.gradle
+++ b/velocity/build.gradle
@@ -23,15 +23,6 @@ repositories {
         name 'papermc'
         url 'https://repo.papermc.io/repository/maven-public/'
     }
-    ivy {
-        url 'https://api.papermc.io/v2/projects/'
-        patternLayout {
-            artifact "[organization]/versions/[module]/builds/[revision]/downloads/[organization]-[module]-[revision](.[ext])"
-        }
-        metadataSources {
-            it.artifact()
-        }
-    }
 }
 
 configurations {
@@ -42,7 +33,7 @@ dependencies {
 //    api 'com.velocitypowered:velocity-api:3.1.1'
 //    annotationProcessor 'com.velocitypowered:velocity-api:3.1.1'
 
-    implementation 'velocity:3.4.0-SNAPSHOT:540'
+    implementation files('libs/velocity-3.4.0-SNAPSHOT-540.jar')
 //    annotationProcessor 'velocity:3.1.2-SNAPSHOT:139'
 
     shadowInclude implementation(project(":common"))
@@ -55,6 +46,33 @@ dependencies {
     api("com.github.RelativityMC.netty-raknet:netty-raknet-server")
 }
 
+// Pinned Velocity server jar (fill API object URL, SHA-256 verified).
+// Replaces the sunset api.papermc.io v2 ivy dependency above.
+def velocityJar = file("libs/velocity-3.4.0-SNAPSHOT-540.jar")
+def velocityJarUrl = "https://fill-data.papermc.io/v1/objects/af292ea5c9c330fc3b367e48c7d1d448b1b3216f597798bfbef662d002b1343b/velocity-3.4.0-SNAPSHOT-540.jar"
+def velocityJarSha256 = "af292ea5c9c330fc3b367e48c7d1d448b1b3216f597798bfbef662d002b1343b"
+
+tasks.register("downloadVelocityJar") {
+    outputs.file(velocityJar)
+    doLast {
+        velocityJar.parentFile.mkdirs()
+        if (!velocityJar.isFile()) {
+            new URL(velocityJarUrl).withInputStream { i -> velocityJar.withOutputStream { it << i } }
+        }
+        def digest = java.security.MessageDigest.getInstance("SHA-256")
+        velocityJar.withInputStream { i -> digest.update(i.bytes) }
+        def actual = digest.digest().encodeHex().toString()
+        if (actual != velocityJarSha256) {
+            velocityJar.delete()
+            throw new GradleException("velocity jar checksum mismatch: $actual")
+        }
+    }
+}
+
+tasks.named("compileJava") {
+    dependsOn("downloadVelocityJar")
+}
+
 processResources {
     inputs.property "version", project.version
 
